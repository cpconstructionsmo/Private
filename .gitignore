# Fichiers de données de chantier : ils contiennent les coordonnées des clients
# (nom, téléphone, adresse). Le dépôt est public — ils ne doivent jamais y entrer.
CP-chantier-*.json
CP-sauvegarde-*.json
*.export.json
CP-artisans-*.json

# dépendances des tests (npm install dans tests/)
tests/node_modules/
tests/*.png

# atelier de conception : environnement Python local et projets (données clients)
atelier/.venv/
atelier/**/__pycache__/
atelier/.pytest_cache/
atelier/projets/

# CP Designer : dépendances et page compilée (la compilation se fait au déploiement)
designer/node_modules/
designer/build/
